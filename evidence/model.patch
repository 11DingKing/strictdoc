+"""
+@relation(SDOC-SRS-107, scope=function)
+"""
+
+from tests.end2end.e2e_case import E2ECase
+from tests.end2end.end2end_test_setup import End2EndTestSetup
+from tests.end2end.helpers.screens.project_index.form_add_document import (
+    Form_AddDocument,
+)
+from tests.end2end.helpers.screens.project_index.screen_project_index import (
+    Screen_ProjectIndex,
+)
+from tests.end2end.server import SDocTestServer
+
+
+class Test(E2ECase):
+    def test(self):
+        test_setup = End2EndTestSetup(path_to_test_file=__file__)
+
+        with SDocTestServer(
+            input_path=test_setup.path_to_sandbox
+        ) as test_server:
+            self.open(test_server.get_host_and_port())
+
+            screen_project_index = Screen_ProjectIndex(self)
+            screen_project_index.assert_on_screen()
+            screen_project_index.assert_contains_document("Existing Document")
+
+            form_add_document: Form_AddDocument = (
+                screen_project_index.do_open_modal_form_add_document()
+            )
+            form_add_document.do_fill_in_title("Different Title")
+            form_add_document.do_fill_in_path("docs/existing.sdoc")
+            form_add_document.do_form_submit_and_catch_error(
+                "A document already exists at this path. Choose another "
+                "path or remove the existing file first."
+            )
+
+            # The existing document is left untouched and still shown.
+            screen_project_index.assert_contains_document("Existing Document")
+
+        assert test_setup.compare_sandbox_and_expected_output()
